{
  "manifest_version": 3,
  "name": "Drift Probe",
  "version": "1.0.0",
  "description": "Test fixture: content script \u2194 service worker messaging and chrome.tabs.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Drift Probe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html",
        "frame.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}